# Copy to .env (gitignored) and fill in. CI does not use this file -- the
# workflow reads the same names from GitHub Actions secrets instead.

# --- fares -----------------------------------------------------------------
# Keys are tried IN ORDER and the switch is sticky for the rest of a run: the
# first is used until SerpApi reports it exhausted or rejected, then the next
# takes over. One key on its own is a perfectly normal setup -- the extras are
# optional and can stay blank.
SERPAPI_KEY=
SERPAPI_KEY_2=
# SERPAPI_KEY_3=

# Equivalent to the above as a single comma-separated list, if you would
# rather manage one variable. Takes precedence when set.
# SERPAPI_KEYS=first,second

# --- alerts ----------------------------------------------------------------
# From @BotFather. CHAT_ID is the conversation the bot posts into.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- quota note ------------------------------------------------------------
# The free tier is 250 searches/month per account. The current 8-route set
# costs 15 requests per poll (7 routes do a second full_read request), so:
#
#   every other day  ~240/month  fits one key, ~96% of it in 31-day months
#   daily            ~465/month  needs a second key
#
# Do not move the cron to daily until a second key is in place, or the month
# will run dry around the 16th.
